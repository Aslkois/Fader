<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Fader</AssemblyName>
    <RootNamespace>Fader.App</RootNamespace>
    <ApplicationIcon>Assets\fader.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>FADER</AssemblyTitle>
    <Description>Per-application Windows audio mixer</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\fader.ico" />
    <Resource Include="Assets\fader-locked.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fader.Core\Fader.Core.csproj" />
    <ProjectReference Include="..\Fader.Audio\Fader.Audio.csproj" />
    <ProjectReference Include="..\Fader.Native\Fader.Native.csproj" />
  </ItemGroup>

</Project>
