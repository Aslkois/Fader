<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained, single-file Windows x64 build. Used by packaging/windows/build.ps1. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ships native libraries (wpfgfx, PresentationNative, ...) that must be bundled and extracted. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Applies to Fader.App only; build.ps1 also passes DebugType=none so referenced projects ship no .pdb either. -->
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
