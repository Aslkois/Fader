<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm graphite. Contrast of Text* on Surface: 12.9 / 7.0 / 4.7. Accent text on Accent: 8.0. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1B1B1A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#242423" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#2D2D2B" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#323230" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3B3B38" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#5A5954" />

    <SolidColorBrush x:Key="Brush.Text" Color="#ECEBE7" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#ABA9A2" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8E8C85" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#E8A33D" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F0B257" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1B1B1A" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="#E8A33D" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#E8A33D" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F0705F" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2623" />

    <SolidColorBrush x:Key="Brush.Track" Color="#3E3E3B" />
    <SolidColorBrush x:Key="Brush.TrackFill" Color="#CFCDC6" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#ECEBE7" />
    <SolidColorBrush x:Key="Brush.ThumbHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ThumbNotch" Color="#1B1B1A" />

    <SolidColorBrush x:Key="Brush.MeterTrack" Color="#2F2F2D" />
    <SolidColorBrush x:Key="Brush.Meter" Color="#8A8880" />
    <SolidColorBrush x:Key="Brush.MeterHot" Color="#F0705F" />

    <SolidColorBrush x:Key="Brush.Shadow" Color="#000000" />
</ResourceDictionary>
