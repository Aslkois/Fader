<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm paper-grey. Contrast of Text* on Surface: 15.5 / 7.1 / 5.1. Accent text on Accent: 8.1. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#EAE9E5" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#F8F7F4" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#EEEDE9" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D4D2CB" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#A9A79F" />

    <SolidColorBrush x:Key="Brush.Text" Color="#1E1E1C" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#55534D" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#6B6963" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#E8A33D" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#DE9526" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1E1E1C" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="#8F5600" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#8F5600" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#F6E1DE" />

    <SolidColorBrush x:Key="Brush.Track" Color="#D4D2CB" />
    <SolidColorBrush x:Key="Brush.TrackFill" Color="#3A3935" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#2A2A28" />
    <SolidColorBrush x:Key="Brush.ThumbHover" Color="#000000" />
    <SolidColorBrush x:Key="Brush.ThumbNotch" Color="#F8F7F4" />

    <SolidColorBrush x:Key="Brush.MeterTrack" Color="#E3E1DB" />
    <SolidColorBrush x:Key="Brush.Meter" Color="#7C7A73" />
    <SolidColorBrush x:Key="Brush.MeterHot" Color="#B3261E" />

    <SolidColorBrush x:Key="Brush.Shadow" Color="#000000" />
</ResourceDictionary>
