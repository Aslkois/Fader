<Window x:Class="Fader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Fader.App.Controls"
        xmlns:v="clr-namespace:Fader.App.Views"
        Title="FADER" Width="460" Height="700" MinWidth="360" MinHeight="460"
        Style="{StaticResource FaderWindow}"
        Icon="pack://application:,,,/Assets/fader.ico"
        WindowStartupLocation="Manual">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The signature control: a wide switch, amber while LOCK IN is on. -->
        <Style x:Key="LockInButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="58" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="Hover" CornerRadius="6" Opacity="0" Background="{DynamicResource Brush.SurfaceHover}" />
                            <ContentPresenter Margin="16,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LockInActive}" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LockInActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwitchTrack" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LockInActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwitchKnob" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LockInActive}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar: brand, output device, theme, settings, window buttons ===== -->
            <Grid Grid.Row="0" Margin="14,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand mark: three faders, one knob in the accent. Same drawing as the app icon. -->
                    <Canvas Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="4" Canvas.Top="3" Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.BorderStrong}" />
                        <Rectangle Canvas.Left="10" Canvas.Top="3" Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.BorderStrong}" />
                        <Rectangle Canvas.Left="16" Canvas.Top="3" Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.BorderStrong}" />
                        <Rectangle Canvas.Left="1.5" Canvas.Top="12" Width="7" Height="3.5" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.Text}" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="5" Width="7" Height="3.5" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.Accent}" />
                        <Rectangle Canvas.Left="13.5" Canvas.Top="9" Width="7" Height="3.5" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.Text}" />
                    </Canvas>
                    <TextBlock Text="FADER" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                </StackPanel>

                <ComboBox Grid.Column="1" Margin="16,0,8,0" MaxWidth="340" MinHeight="32" VerticalAlignment="Center"
                          ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          ItemTemplate="{StaticResource DeviceChoiceTemplate}"
                          AutomationProperties.Name="Output device"
                          ToolTip="Output device whose master volume and apps are shown"
                          WindowChrome.IsHitTestVisibleInChrome="True" />

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{Binding ThemeGlyph}"
                        Command="{Binding CycleThemeCommand}" ToolTip="{Binding ThemeTip}"
                        AutomationProperties.Name="Change theme" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;"
                        Command="{Binding OpenSettingsCommand}" ToolTip="{Binding SettingsButtonTip}"
                        AutomationProperties.Name="Settings" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="4" x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="11"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="5" x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="11"
                        ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <!-- ===== LOCK IN ===== -->
            <Button Grid.Row="1" Margin="12,2,12,0" Style="{StaticResource LockInButton}"
                    Command="{Binding ToggleLockInCommand}" AutomationProperties.Name="LOCK IN">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LOCK IN" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding LockInSubtitle}" FontSize="12" Opacity="0.88" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SwitchTrack}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource SwitchKnob}" />
                    </Border>
                </Grid>
            </Button>

            <!-- ===== Strip: what turning LOCK IN off will do, restore prompt, notices ===== -->
            <StackPanel Grid.Row="2">
                <Grid Margin="14,8,12,0" Visibility="{Binding ShowLockInStrip, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LockInHint}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{Binding LockInAlternateLabel}"
                            Command="{Binding LockInAlternateCommand}" Margin="8,0,0,0"
                            Visibility="{Binding ShowLockInAlternate, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <Border Margin="12,8,12,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource Brush.SurfaceRaised}"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                        Visibility="{Binding ShowRestorePrompt, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Turn LOCK IN off" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Put every app back where it was, or keep the levels as they are now?" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <WrapPanel>
                            <Button Content="Restore previous levels" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                            <Button Content="Keep current levels" Command="{Binding KeepCommand}" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelPromptCommand}" Style="{StaticResource QuietButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="12,8,12,0" Padding="12,8,6,8" CornerRadius="6" Background="{DynamicResource Brush.DangerSoft}"
                        BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                                Command="{Binding DismissBannerCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===== Page: mixer or settings ===== -->
            <Grid Grid.Row="3">
                <Grid Visibility="{Binding IsMixerOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Master: bigger and raised, so it never reads as just another app row. -->
                    <Border Margin="12,10,12,0" Padding="14,12,10,12" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                        <Grid DataContext="{Binding Master}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Master volume" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Text.Value}"
                                       FontFamily="{StaticResource Font.Display}" FontSize="30" VerticalAlignment="Center" MinWidth="76" />

                            <Slider Grid.Row="1" Style="{StaticResource MasterSlider}" Margin="0,8,8,0"
                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding HasEndpoint}" AutomationProperties.Name="Master volume" />
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource MuteToggle}" Margin="0,8,0,0" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsMuted, Mode=OneWay}" Command="{Binding ToggleMuteCommand}"
                                          ToolTip="Mute or unmute the whole output device" AutomationProperties.Name="Mute master volume" />

                            <c:MeterBar Grid.Row="2" Grid.ColumnSpan="2" Height="4" Margin="0,2,8,0"
                                        Value="{Binding Meter}" Track="{DynamicResource Brush.MeterTrack}"
                                        Fill="{DynamicResource Brush.Meter}" HotFill="{DynamicResource Brush.MeterHot}" />

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,8,0">
                                <TextBlock.Visibility>
                                    <Binding Path="IsFallback" Converter="{StaticResource BoolToVis}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Applications header -->
                    <Grid Grid.Row="1" Margin="14,14,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Applications" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding AppCount, StringFormat='  {0} playing or open'}" Style="{StaticResource Text.Tertiary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8FD;" Width="30" Height="30" FontSize="13"
                                Command="{Binding ToggleCompactCommand}" ToolTip="{Binding CompactTip}" AutomationProperties.Name="Toggle compact rows" />
                    </Grid>

                    <!-- Application list and its empty, loading and error states -->
                    <Border Grid.Row="2" Margin="12,0,12,12" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <v:AppRowView />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Margin="24" VerticalAlignment="Center" MaxWidth="320"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Looking for audio sessions" Style="{StaticResource PlaceholderTitle}" />
                                <TextBlock Text="This takes a moment while Windows reports which apps can play sound." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="24" VerticalAlignment="Center" MaxWidth="340"
                                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No app has opened audio yet" Style="{StaticResource PlaceholderTitle}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Start a game, Discord or some music and it appears here by itself. Right-click an app to pin it so it stays in the list when closed." />
                            </StackPanel>

                            <StackPanel Margin="24" VerticalAlignment="Center" MaxWidth="340"
                                        Visibility="{Binding ShowNoDevice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No audio output device" Style="{StaticResource PlaceholderTitle}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Plug in or enable a speaker or headset in Windows sound settings. FADER notices as soon as one appears." />
                                <Button Content="Check again" Command="{Binding RetryCommand}" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Margin="24" VerticalAlignment="Center" MaxWidth="340"
                                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Windows audio is not responding" Style="{StaticResource PlaceholderTitle}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding ErrorText}" />
                                <Button Content="Try again" Command="{Binding RetryCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <v:SettingsView DataContext="{Binding Settings}" />
                </Grid>

                <!-- Transient confirmation for actions started in this window -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,22" Padding="14,9" CornerRadius="6"
                        Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                        Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black" />
                    </Border.Effect>
                    <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" MaxWidth="360" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
