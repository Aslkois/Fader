<UserControl x:Class="Fader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fader.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="FieldCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="ProblemText" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,6,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back to the mixer (Esc)" AutomationProperties.Name="Back to the mixer"
                    Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </Grid>

        <TabControl Grid.Row="1">
            <!-- ===================== General ===================== -->
            <TabItem Header="General">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="2,0,10,16">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <Border CornerRadius="6" Padding="3" HorizontalAlignment="Left" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="Follow Windows" IsChecked="{Binding ThemeSystem, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="Light" IsChecked="{Binding ThemeLight, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Theme" Content="Dark" IsChecked="{Binding ThemeDark, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <CheckBox Style="{StaticResource FieldCheck}" Content="Compact application rows" IsChecked="{Binding CompactRows, Mode=TwoWay}" />

                        <TextBlock Text="Output device" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DeviceChoiceTemplate}" AutomationProperties.Name="Output device" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Follow the Windows default, follow the communications default (a headset, often), or pin one device. If a pinned device is unplugged, FADER shows the Windows default until it comes back." />
                        <CheckBox Style="{StaticResource FieldCheck}" Content="Also list apps that play on other output devices" IsChecked="{Binding ShowAppsOnOtherDevices, Mode=TwoWay}" />

                        <TextBlock Text="Startup and window" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Start FADER when I sign in to Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Adds a startup entry for your account only while this is on. FADER then starts in the tray without opening a window. No service or driver is installed." />
                        <CheckBox Style="{StaticResource FieldCheck}" Content="Closing the window keeps FADER running in the tray" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Help}" Text="Turn this off and the close button quits FADER. The tray menu always has Quit." />
                        <CheckBox Style="{StaticResource FieldCheck}" Content="Show an on-screen message when a shortcut runs" IsChecked="{Binding ShowHotkeyFeedback, Mode=TwoWay}" />

                        <TextBlock Text="Volume step" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource FaderSlider}" Minimum="1" Maximum="25" Value="{Binding VolumeStep, Mode=TwoWay}"
                                    AutomationProperties.Name="Volume step" />
                            <TextBlock Grid.Column="1" Text="{Binding VolumeStepText}" Style="{StaticResource Text.Value}" MinWidth="48" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource Help}" Text="How far the volume shortcuts and the mouse wheel move a level (the wheel works on a slider that has focus)." />

                        <TextBlock Text="Your data" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0" TextWrapping="Wrap"
                                   Text="Everything stays on this PC: no account, no telemetry, no network access. Settings are saved to:" />
                        <TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Button Content="Open the settings folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />

                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Help}" Text="Free and open source under the MIT license." />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="FADER sets the volume of each Windows app. It cannot change individual people inside a Discord call, because Windows exposes Discord as one audio stream." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Shortcuts ===================== -->
            <TabItem Header="Shortcuts">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="2,16,10,16">
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,14"
                                   Text="These work while a game or any other app has focus. Click a box, then press the keys. A shortcut needs Ctrl, Alt or Shift." />
                        <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Content="On" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:HotkeyBox Style="{StaticResource {x:Type TextBox}}" Gesture="{Binding Gesture, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Label, StringFormat='{}{0} shortcut'}" />
                                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" Style="{StaticResource QuietButton}" />
                                            <Button Grid.Column="2" Content="Default" Command="{Binding ResetCommand}" Margin="4,0,0,0" Style="{StaticResource QuietButton}" />
                                        </Grid>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource ProblemText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Chat app for the mute and volume shortcuts" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                        <TextBox Text="{Binding ChatTargetsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Chat app executables" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Executable names, separated by commas. The default covers Discord, Discord PTB and Canary, Vesktop and Legcord." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Profiles ===================== -->
            <TabItem Header="Profiles">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="2,16,10,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="Profile" />
                            <Button Grid.Column="1" Content="New" Command="{Binding NewProfileCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="Duplicate" Command="{Binding DuplicateProfileCommand}" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="Name" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="40"
                                 IsEnabled="{Binding CanEditName}" AutomationProperties.Name="Profile name" />

                        <TextBlock Text="Levels" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8"
                                   Text="A specific app beats its group. Apps and groups that are not listed are left alone." />

                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding KindText, StringFormat='  {0}'}" Style="{StaticResource Text.Tertiary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource Text.Value}" MinWidth="46" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="26" Height="26" Margin="4,-3,0,0"
                                                    Command="{Binding RemoveCommand}" ToolTip="Remove from this profile" AutomationProperties.Name="Remove from this profile" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FaderSlider}" Margin="0,2,8,0"
                                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='{}{0} level'}" />
                                            <CheckBox Grid.Row="1" Grid.Column="2" Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Help}" Margin="0,10,0,0" Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVis}}"
                                   Text="This profile does nothing yet. Add a group such as Chat apps, or an app that is running, to give it a level." />

                        <Grid Margin="0,14,0,0">
                            <ComboBox ItemsSource="{Binding AddTargets}" SelectedItem="{Binding AddTarget, Mode=TwoWay}" AutomationProperties.Name="Add an app or group">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Text.Tertiary}" Margin="16,0,0,0" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Add an app or group" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Apply this profile now" Command="{Binding ApplyProfileCommand}" Margin="0,0,8,6" />
                            <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,6"
                                    Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Restore shipped levels" Command="{Binding ResetProfileCommand}" Margin="0,0,8,6"
                                    Visibility="{Binding ShowReset, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Applying a profile saves the previous levels first, so Restore previous levels (tray or shortcut) can undo it. Right-click an app in the mixer to save its current level into a profile." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== LOCK IN ===================== -->
            <TabItem Header="LOCK IN">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="2,16,10,16">
                        <TextBlock Text="Profile LOCK IN applies" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding LockInProfile, Mode=TwoWay}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="LOCK IN profile" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Edit the levels on the Profiles tab. The shipped LOCK IN profile sets the current game to 100%, chat apps to 20%, music to 30% and browsers to 15%." />

                        <TextBlock Text="When LOCK IN turns off" Style="{StaticResource SectionTitle}" />
                        <RadioButton GroupName="Policy" IsChecked="{Binding PolicyRestore, Mode=TwoWay}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Restore the previous levels" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Every app goes back to where it was when LOCK IN started." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Policy" IsChecked="{Binding PolicyKeep, Mode=TwoWay}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Keep the current levels" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Nothing moves. The levels LOCK IN set stay until you change them." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Policy" IsChecked="{Binding PolicyAsk, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Ask me in the FADER window" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                           Text="Shortcuts and the tray cannot ask without interrupting a game, so they restore." />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="While LOCK IN is on" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,0" Text="Apps that start playing sound get their level from the profile too. Levels you change by hand are left alone." />
                        <CheckBox Style="{StaticResource FieldCheck}" Content="Put levels back if another program changes them" IsChecked="{Binding EnforceProfile, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Off by default. When on, FADER corrects changes made outside FADER (a game, Discord, the Windows mixer) to apps in the profile, at most three times in five seconds per app." />

                        <TextBlock Text="How the current game is found" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0"
                                   Text="When LOCK IN starts, the current game is the app you have in front, or the only app making sound that is not chat, music or a browser. If FADER picks wrong, right-click that app in the mixer and choose Counts as, then Game." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
